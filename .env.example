# Host address and port of the web entrypoint. On the VM behind the router: 0.0.0.0 and 8081.
NOTES_HTTP_BIND=127.0.0.1
NOTES_HTTP_PORT=8080
# The only address allowed to pass the client address in X-Real-IP: the reverse proxy in front
# of the service. 127.0.0.1 when there is none.
NOTES_TRUSTED_PROXY=127.0.0.1
