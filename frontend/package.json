{
  "name": "notes-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "api:types": "openapi-typescript ../docs/openapi.yaml -o src/api/schema.gen.ts",
    "dev": "vite",
    "typecheck": "npm run api:types && tsc --noEmit",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.106.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
