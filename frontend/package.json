{
  "name": "notes-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "api:types": "openapi-typescript ../docs/openapi.yaml -o src/api/schema.gen.ts",
    "dev": "vite",
    "typecheck": "npm run api:types && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.106.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "swagger-ui-dist": "5.34.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  },
  "overrides": {
    "minimatch@^10": "11.0.4"
  }
}
