{
    "name": "notes/backend",
    "description": "Notes REST API: Bitrix D7 module app.notes",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "~8.3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "guzzlehttp/guzzle": "^7.10",
        "league/openapi-psr7-validator": "^0.24",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4"
    },
    "autoload": {
        "psr-4": {
            "App\\Notes\\": "local/modules/app.notes/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Notes\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
